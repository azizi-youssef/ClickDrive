# Laisser vide en prod : le client utilise le BFF Next.js (/app/api/*)
# NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only; required for secure customer dossiers, invitations, and shared rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Cloud API Webhook Verify Token (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_random_64char_webhook_token
# App Secret Meta : vérifie la signature X-Hub-Signature-256 des webhooks WhatsApp
WHATSAPP_APP_SECRET=your_meta_app_secret

# E-mails transactionnels (Resend) : accusés de réception, suivi des réservations, alertes contact.
# Sans ces deux variables, aucun e-mail n'est envoyé (et rien n'est présenté comme envoyé).
RESEND_API_KEY=your-resend-api-key
# Expéditeur d'un domaine vérifié chez Resend
EMAIL_FROM="ClickDrive <notifications@clickdrive.ma>"
# Boîte de l'équipe qui reçoit les messages du formulaire de contact (défaut : contact@clickdrive.ma)
CONTACT_INBOX_EMAIL=contact@clickdrive.ma

# Liens signés envoyés au client (PDF, suivi sans compte, avis). À définir : sinon le secret
# Supabase sert de clé de signature, et changer cette clé invaliderait tous les liens déjà envoyés.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_LINK_SECRET=your-random-64-hex-secret
# Adresse publique du site (liens des e-mails envoyés par la tâche de relance)
NEXT_PUBLIC_APP_URL=https://clickdrive.ma

# Tâche de relance (frontend/src/app/api/cron/booking-follow-up) : même valeur dans le secret GitHub CRON_SECRET
CRON_SECRET=your-random-cron-secret

# Modèles WhatsApp approuvés par Meta (voir docs/whatsapp-templates.md) ; vide = notification non envoyée
WHATSAPP_TEMPLATE_AGENCY_NEW_REQUEST=
WHATSAPP_TEMPLATE_AGENCY_REMINDER=
WHATSAPP_TEMPLATE_REQUEST_RECEIVED=
WHATSAPP_TEMPLATE_REQUEST_CONFIRMED=
WHATSAPP_TEMPLATE_REQUEST_REJECTED=
WHATSAPP_TEMPLATE_REQUEST_ALTERNATIVE=
WHATSAPP_TEMPLATE_REVIEW_REQUEST=
# Langues dont la traduction des modèles client est approuvée par Meta (ex. fr,en,nl) ; les autres reçoivent le français
WHATSAPP_TEMPLATE_LANGUAGES=fr

# Mesure d'audience sans cookie (Plausible) ; vide = aucune mesure, aucun script chargé
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Lien « laisser un avis » de la fiche Google Business Profile (proposé après un avis ClickDrive)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
